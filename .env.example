# F.R.I.D.A.Y. Environment Configuration Example
# Copy to .env if needed

FRIDAY_LOG_LEVEL=INFO
FRIDAY_OLLAMA_URL=http://localhost:11434
RELEASE_TEST_MODE=0

# Reasoning provider: "ollama" (Ollama) or "llamacpp" (llama.cpp / Bonsai)
# When set, FRIDAY_REASONING_PROVIDER overrides config.yaml reasoning.provider
FRIDAY_REASONING_PROVIDER=llamacpp

# llama.cpp / Bonsai server settings
LLAMACPP_BASE_URL=http://127.0.0.1:8080
LLAMACPP_MODEL=C:\AI\models\Bonsai-8B-Q1_0.gguf
LLAMACPP_TIMEOUT=30
