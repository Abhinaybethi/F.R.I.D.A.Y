# F.R.I.D.A.Y. Environment Configuration Example
# Copy to .env if needed

FRIDAY_LOG_LEVEL=INFO
FRIDAY_OLLAMA_URL=http://localhost:11434
RELEASE_TEST_MODE=0

# Reasoning provider: "ollama" (Ollama) or "llamacpp" (llama.cpp / Bonsai)
# or "nvidia" (NVIDIA API Catalog — hosted, requires NVIDIA_API_KEY env var)
# When set, FRIDAY_REASONING_PROVIDER overrides config.yaml reasoning.provider
FRIDAY_REASONING_PROVIDER=llamacpp

# NVIDIA API Catalog settings (used when provider=nvidia):
#   NVIDIA_API_KEY    — bearer token (never logged, never printed)
#   NVIDIA_BASE_URL   — API base URL (default: https://integrate.api.nvidia.com/v1)
#   NVIDIA_MODEL      — model identifier (default: nvidia/nemotron-3.5-bolt-e4b)
FRIDAY_NVIDIA_API_KEY=
FRIDAY_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
FRIDAY_NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# llama.cpp / Bonsai server settings
LLAMACPP_BASE_URL=http://127.0.0.1:8080
LLAMACPP_MODEL=C:\AI\models\Bonsai-8B-Q1_0.gguf
LLAMACPP_TIMEOUT=30

# Research subsystem (Phase 1/2) — all optional; defaults mirror config.yaml
# research.*. Live web research is enabled by default; set
# WEB_RESEARCH_ENABLED=0 to turn it off (kill switch). When disabled
# F.R.I.D.A.Y. continues exactly as before.
WEB_RESEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=10

# Natural Conversation Layer - deterministic local answers for pure chatter
# (greetings, wellbeing, thanks, acknowledgements, feedback, farewells,
# readiness, ordinary first-person statements).
# Overrides natural_conversation.enabled in config.yaml. Disable to fall back
# to the reasoner for every turn. No LLM is used when the layer handles a turn.
FRIDAY_NATURAL_CONVERSATION_ENABLED=true

# Deterministic System Router - locally answerable system questions (currently
# the current time) are answered from the local clock instead of the reasoner.
# Overrides system_commands.enabled in config.yaml.
FRIDAY_SYSTEM_COMMANDS_ENABLED=true

# Local Qwen-Image generation via stable-diffusion.cpp (sd-cli).
# All optional; defaults mirror the config.yaml `image:` block. Nothing loads
# at startup. Model layout when *_PATH vars are unset:
#   models/qwen-image/diffusion/*.gguf    FRIDAY_QWEN_IMAGE_MODEL_PATH
#   models/qwen-image/text_encoder/*.gguf FRIDAY_QWEN_TEXT_ENCODER_PATH
#   models/qwen-image/vae/*.safetensors   FRIDAY_QWEN_VAE_PATH
# Download everything (runtime + the three model components) with:
#   python -m friday.image setup [--backend cpu|vulkan|cuda]
FRIDAY_IMAGE_ENABLED=true
FRIDAY_IMAGE_PROVIDER=qwen-image
FRIDAY_QWEN_SD_EXECUTABLE=sd-cli
FRIDAY_QWEN_IMAGE_MODEL_PATH=
FRIDAY_QWEN_TEXT_ENCODER_PATH=
FRIDAY_QWEN_VAE_PATH=
FRIDAY_QWEN_OUTPUT_DIR=output/generated_images
FRIDAY_QWEN_DEVICE=auto
# auto | cpu | gpu — keep the ~4.3GB text encoder off small GPUs. auto => the
# encoder runs on CPU when CUDA VRAM < 10 GB (diffusion/VAE stay on GPU).
FRIDAY_QWEN_TEXT_ENCODER_DEVICE=auto
FRIDAY_QWEN_KEEP_LOADED=true
# Stop F.R.I.D.A.Y.'s own reasoner server during image generation so the ~4GB
# diffusion model stays GPU-resident (roughly 2x faster; needs ~5GB free VRAM).
FRIDAY_QWEN_FREE_VRAM=true
FRIDAY_QWEN_PROMPT_ENHANCEMENT=false
FRIDAY_QWEN_WIDTH=768
FRIDAY_QWEN_HEIGHT=768
FRIDAY_QWEN_STEPS=8
FRIDAY_QWEN_CFG_SCALE=2.5
FRIDAY_QWEN_TIMEOUT=900
# Extra tokens appended to each sd-cli run (e.g. 2.1 prefix-cache tuning for low
# VRAM). An explicit --backend here overrides FRIDAY_QWEN_TEXT_ENCODER_DEVICE, e.g.
# for a laptop with an iGPU as vulkan0 and an NVIDIA dGPU as vulkan1:
# FRIDAY_QWEN_EXTRA_ARGS=--backend "diffusion=vulkan1,vae=vulkan1,llm=cpu"
# FRIDAY_QWEN_EXTRA_ARGS=--model-args qwen_image_2_1_prefix_cache_type=q4_0
